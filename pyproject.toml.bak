[project]
name = "poc_databricks_01"
version = "0.0.1"
authors = [{ name = "corina_ww@yahoo.com" }]
requires-python = ">=3.12,<3.13"
# Notebooks run on Databricks serverless, which provides Spark and common libraries.
# Runtime dependencies for jobs go in the job's environment spec, not here.
dependencies = []

[dependency-groups]
# Local development only: editor, tests, linting.
dev = [
    # Must match the serverless environment version used by the jobs (6 → Databricks Connect 19).
    "databricks-connect~=19.0",
    # Not a runtime dependency: the jobs get DQX from the bundle's
    # silver_job_dependencies variable. This is here so the editor and ruff
    # resolve the import. Keep the pin equal to the one in databricks.yml.
    "databricks-labs-dqx==0.16.0",
    "pytest",
    "ruff",
    "ipykernel",
]

[tool.ruff]
line-length = 120

[tool.databricks.environment]
environment_version = "6"
