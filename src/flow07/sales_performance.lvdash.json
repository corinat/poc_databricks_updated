{
  "datasets": [
    {
      "name": "daily_sales_summary",
      "displayName": "Daily Sales Summary",
      "config": {
        "source": "gold_datamart_daily_sales_summary",
        "measures": [
          {
            "name": "sales_pln",
            "expr": "SUM(sales_pln)",
            "format": {
              "type": "currency",
              "currencyCode": "PLN",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "order_count",
            "expr": "SUM(order_count)"
          },
          {
            "name": "item_quantity",
            "expr": "SUM(item_quantity)"
          }
        ],
        "version": "1.1",
        "comment": "Daily sales summary by date, currency, and product category. Cancelled orders excluded. sales_pln is the only cross-currency comparable measure.",
        "dimensions": [
          {
            "name": "sales_date",
            "expr": "sales_date"
          },
          {
            "name": "currency_code",
            "expr": "currency_code"
          },
          {
            "name": "product_category",
            "expr": "product_category"
          }
        ]
      }
    },
    {
      "name": "order_sales_detail",
      "displayName": "Order Sales Detail",
      "config": {
        "source": "gold_datamart_order_sales_detail",
        "measures": [
          {
            "name": "order_count",
            "expr": "COUNT(*)"
          },
          {
            "name": "order_amount_pln",
            "expr": "SUM(order_amount_pln)",
            "format": {
              "type": "currency",
              "currencyCode": "PLN",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          }
        ],
        "version": "1.1",
        "comment": "Order-level sales detail. Includes cancelled orders. order_amount_pln is the cross-currency converted measure.",
        "dimensions": [
          {
            "name": "order_status",
            "expr": "order_status"
          },
          {
            "name": "order_date",
            "expr": "order_date"
          },
          {
            "name": "currency_code",
            "expr": "currency_code"
          }
        ]
      }
    }
  ],
